{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.getshareglow/mcp",
  "title": "Shareglow",
  "description": "Shareglow MCP server: scan link previews, generate OG images, short links and stats.",
  "repository": {
    "url": "https://github.com/Brandon-35/shareglow-mcp",
    "source": "github"
  },
  "websiteUrl": "https://getshareglow.com",
  "version": "0.1.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.getshareglow.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Shareglow API key as a Bearer token (sk_live_...), created in the Shareglow dashboard.",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Shareglow API key (sk_live_...)",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
